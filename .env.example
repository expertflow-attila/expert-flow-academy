# ─── Auth.js (NextAuth v5) ─────────────────────────────────────────────
AUTH_SECRET=                       # openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000 # production: https://akademia.expertflow.hu

# ─── Email (SMTP — Brevo / Resend / Postmark) ─────────────────────────
# Brevo formátum: smtp://APIKEY@smtp-relay.brevo.com:587
EMAIL_SERVER=
EMAIL_FROM=akademia@expertflow.hu

# ─── Supabase ─────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Stripe ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=             # stripe listen → /api/stripe/webhook

# ─── Cloudflare Stream ────────────────────────────────────────────────
CF_STREAM_ACCOUNT_ID=
CF_STREAM_SIGNING_KEY_ID=
CF_STREAM_SIGNING_KEY_JWK=         # teljes JWK JSON egy sorban

# ─── Kit V4 (ConvertKit) ──────────────────────────────────────────────
KIT_V4_KEY=
COURSE_WELCOME_SEQUENCE_ID=        # Kit sequence id új member-eknél

# ─── Admin (kurzus szerkesztő hozzáférés) ─────────────────────────────
# Vesszővel elválasztott email lista — csak ezek a userek látják a /admin/courses-t
ADMIN_EMAILS=hello@expertflow.hu

# ─── Lead Magnet (Wave 4 — Hormozi keret) ─────────────────────────────
# Claude API a térkép és vázlat generáláshoz
ANTHROPIC_API_KEY=

# Vercel Cron-ok (process-pending 1 perc, auto-release 1 óra)
CRON_SECRET=                       # openssl rand -base64 32

# Hermes (hostinger VPS) review gate
# A 4 lib/hermes-notifier.ts ide POST-ol Telegram értesítéssel.
# Ha üres → review gate ki van kapcsolva, auto-released 18h után.
HERMES_NOTIFY_URL=                 # pl. http://82.29.178.127:7000/api/notify
HERMES_NOTIFY_SECRET=              # közös HMAC titok a Hermes-szel

# Cal.com event type az LM3 (ügyfélút audit) számára
CAL_AUDIT_URL=https://cal.com/solobusiness/ugyfelut-audit

# MailerLite — 41 leveles Expert Flow edu newsletter group
# Az LM1/LM2/LM3 form-on "marketing_consent: true" jelzéssel érkezett
# ügyfelek auto-enroll itt. Részletek: memory/project_solo_business_newsletter.md
MAILERLITE_API_KEY=
MAILERLITE_NEWSLETTER_GROUP_ID=188014583560013564

# Cal.com webhook a kvalifikált audit foglalásokhoz
CAL_WEBHOOK_SECRET=                # HMAC titok a Cal.com webhook verifikációhoz

# ─── Wave 5 — Fizetős audit (LM8 / LM10 / LM11) ───────────────────────
# Stripe Dashboard-on kézzel hozz létre 2 Product-ot + 1 Coupon-t, ID-kat ide:
STRIPE_PRICE_AUDIT_9900=            # price_... — 9 900 HUF one-time, "9 900 Ft Belépő Audit"
STRIPE_PRICE_AUDIT_BUNDLE_9900=     # price_... — 9 900 HUF one-time, "Audit + Bundle"
STRIPE_PRICE_TELJES_AUDIT_359K=     # price_... — 359 000 HUF, "Teljes Audit + Rendszerterv"
STRIPE_COUPON_AUDIT_REDEMPTION=     # coupon_... — 9 900 Ft fix-amount off, currency=huf

# ─── Wave 5 — Whisper (LM3 mondd-el-egyszer) ──────────────────────────
# OpenAI Whisper a hangüzenet-transzkripciókhoz. Heti ~10 LM3 esetén ~200 Ft/hét.
OPENAI_API_KEY=

# ─── Supabase Storage bucket (LM3 audio file-ok) ──────────────────────
# A "lead-magnet-audio" bucket-et kézzel kell létrehozni a Supabase Dashboard-on:
#   1. Storage → New bucket → name: lead-magnet-audio, public: NEM
#   2. Bucket policy: csak service_role írhat/olvashat
#   3. 30 napos retention (Storage → Lifecycle policies) ajánlott

