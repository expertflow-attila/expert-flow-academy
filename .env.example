# ─── Auth.js (NextAuth v5) ─────────────────────────────────────────────
AUTH_SECRET=                       # openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000 # production: https://akademia.solobusiness.hu

# ─── Email (SMTP — Brevo / Resend / Postmark) ─────────────────────────
# Brevo formátum: smtp://APIKEY@smtp-relay.brevo.com:587
EMAIL_SERVER=
EMAIL_FROM=akademia@solobusiness.hu

# ─── Supabase ─────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Stripe ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=             # stripe listen → /api/stripe/webhook

# ─── Cloudflare Stream ────────────────────────────────────────────────
CF_STREAM_ACCOUNT_ID=
CF_STREAM_SIGNING_KEY_ID=
CF_STREAM_SIGNING_KEY_JWK=         # teljes JWK JSON egy sorban

# ─── Kit V4 (ConvertKit) ──────────────────────────────────────────────
KIT_V4_KEY=
COURSE_WELCOME_SEQUENCE_ID=        # Kit sequence id új member-eknél
